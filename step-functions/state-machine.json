{
    "Comment": "A description of my state machine",
    "StartAt": "ResizeImage",
    "States": {
        "ResizeImage": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "Payload": "{% $states.input %}",
                "FunctionName": "arn:aws:lambda:us-east-2:448678333340:function:ImageResizerFunction:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                }
            ],
            "Next": "CheckResult"
        },
        "CheckResult": {
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "Success",
                    "Condition": "{% $states.input.statusCode = 200 %}"
                }
            ],
            "Default": "Fail"
        },
        "Success": {
            "Type": "Succeed"
        },
        "Fail": {
            "Type": "Fail"
        }
    },
    "QueryLanguage": "JSONata"
}